#pragma once
// Copy to secrets.h (git-ignored) and fill in. Used by WifiTimeSync / SignalKSource.

// Networks in priority order: the first one seen in a scan is joined.
// remote: true = internet-only network (e.g. phone hotspot): read Home Assistant over
// Tailscale Funnel (HTTPS) instead of SignalK/HA on the boat LAN
struct WifiCred { const char* ssid; const char* password; bool remote; };
static const WifiCred WIFI_NETWORKS[] = {
    { "BOAT_WIFI_SSID",  "password", false },   // boat LAN: SignalK + Home Assistant directly
    { "HOME_WIFI_SSID",  "password", false },   // a LAN that routes to the boat (e.g. via Tailscale)
    { "PHONE_HOTSPOT",   "password", true  },   // anywhere else: Home Assistant via Funnel
};

// SignalK server (data + clock fallback when the network has no internet)
#define SIGNALK_BASE_URL "http://192.168.1.30:3000"

// Home Assistant (house + engine batteries). Create a long-lived access token in HA:
// your profile -> Security -> Long-lived access tokens. Empty = batteries not read.
#define HA_BASE_URL "http://192.168.1.30:8123"
#define HA_TOKEN ""

// Home Assistant's public HTTPS address (Tailscale Funnel), used on remote networks
#define HA_REMOTE_URL "https://your-ha-host.your-tailnet.ts.net"
